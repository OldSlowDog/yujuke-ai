{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    // ⚠️ 必须显式锁定 rootDir：若把 prisma/**/* 也纳入 include，tsc 会把共同根目录
    //    推断成项目根，产物变成 dist/src/main.js（Dockerfile 里 node dist/main.js 直接
    //    MODULE_NOT_FOUND）。seed 走 ts-node 运行，不需要进主构建。
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": false,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
