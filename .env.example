# ===== PostgreSQL =====
# 本地 docker-compose 默认值；生产请替换为托管库连接串（绝不提交真实串）
POSTGRES_USER=yujuke
POSTGRES_PASSWORD=yujuke_dev_only
POSTGRES_DB=yujuke
DATABASE_URL="postgresql://yujuke:yujuke_dev_only@localhost:5432/yujuke?schema=public"

# ===== Redis =====
REDIS_URL="redis://localhost:6379"

# ===== 服务端口 =====
PORT=3000

# ===== 推理上游（自托管 llama.cpp，OpenAI 兼容 HTTP）=====
# 生产经 frp 隧道指向笔记本边缘推理；需与门户一致的 X-Sup-Key 鉴权
LLM_UPSTREAM="http://172.17.0.1:18081"
LLM_SUP_KEY=""
# 模型名（llama.cpp /v1/models 返回的 id；留空则发 "local"）
LLM_MODEL="local"
LLM_MAX_TOKENS=768
LLM_TEMPERATURE=0.6

# ===== 鉴权（示例占位，非真实凭证） =====
# 网页端白名单用户（逗号分隔）
API_AUTH_WHITELIST="alice,bob"
# 服务间共享密钥（生产用环境变量注入，绝不入库）
INTERNAL_SHARED_SECRET="change-me-in-production"

# ===== 缓存策略 =====
CACHE_DEFAULT_TTL_MS=60000
CACHE_JITTER_MS=15000
CACHE_NULL_TTL_MS=5000

# ===== Agent 循环护栏 =====
AGENT_MAX_STEPS=100
AGENT_REPEAT_LIMIT=3
AGENT_REPEAT_HARD=5
