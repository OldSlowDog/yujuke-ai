{
  "name": "yujuke-ai-backend",
  "version": "0.1.0",
  "description": "隅居客自托管私有 AI 助手 · 后端参考实现（NestJS + PostgreSQL + Redis + gRPC）",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
