# ===== PostgreSQL =====
# 注意：postgres 服务名在 compose 网络内为 postgres；api 用服务名连接
POSTGRES_USER=yujuke
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=yujuke
DATABASE_URL="postgresql://yujuke:CHANGE_ME_STRONG_PASSWORD@postgres:5432/yujuke?schema=public"

# ===== Redis =====
REDIS_URL="redis://redis:6379"

# ===== 服务端口 =====
PORT=3000

# ===== 推理上游（frp 隧道 → 笔记本 llama.cpp）=====
# 容器内经 docker 宿主机桥 172.17.0.1 抵达 VPS frps(18081) → 笔记本 8081
LLM_UPSTREAM="http://172.17.0.1:18081"
# 与门户一致的 X-Sup-Key（生产注入，绝不入库）
LLM_SUP_KEY="PASTE_REAL_KEY_HERE"
LLM_MODEL="D:/Models/Qwen3.5-4B-Uncensored-HauhauCS-Aggressive-Q6_K.gguf"
LLM_MAX_TOKENS=768
LLM_TEMPERATURE=0.6

# ===== 鉴权 =====
# 网页端白名单用户（逗号分隔）；演示可填 demo
API_AUTH_WHITELIST="demo"
INTERNAL_SHARED_SECRET="change-me-in-production"

# ===== 缓存策略 =====
CACHE_DEFAULT_TTL_MS=60000
CACHE_JITTER_MS=15000
CACHE_NULL_TTL_MS=5000

# ===== Agent 循环护栏 =====
AGENT_MAX_STEPS=100
AGENT_REPEAT_LIMIT=3
AGENT_REPEAT_HARD=5
